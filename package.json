{
  "name": "vanilla-hentai-list",
  "description": "A static, searchable review catalogue with batched cover lookups.",
  "private": true,
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "https://github.com/Neo-X2025/vanilla-hentai-list.git"
  },
  "bugs": "https://github.com/Neo-X2025/vanilla-hentai-list/issues",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/serve.cjs",
    "check": "node scripts/check-compat.cjs && node scripts/validate-data.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:live": "node scripts/smoke-api.cjs",
    "setup:chrome56": "node scripts/setup-chrome56.cjs",
    "test:chrome56": "node scripts/test-chrome56.cjs"
  },
  "devDependencies": {
    "@mdn/browser-compat-data": "8.1.8",
    "acorn": "8.19.0",
    "playwright": "1.63.0",
    "postcss": "8.5.32"
  }
}
